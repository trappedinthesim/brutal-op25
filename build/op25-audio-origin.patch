diff --git a/op25/gr-op25_repeater/lib/op25_audio.cc b/op25/gr-op25_repeater/lib/op25_audio.cc
--- a/op25/gr-op25_repeater/lib/op25_audio.cc
+++ b/op25/gr-op25_repeater/lib/op25_audio.cc
@@ -178,5 +178,14 @@
             d_ws_endpt.init_asio();
             d_ws_endpt.set_reuse_addr(true);
+            // The dashboard is published on host loopback. A browser on an unrelated
+            // website must not be allowed to open this local audio stream.
+            d_ws_endpt.set_validate_handler([this](websocketpp::connection_hdl hdl) {
+                websocketpp::lib::error_code ec;
+                auto con = d_ws_endpt.get_con_from_hdl(hdl, ec);
+                if (ec) return false;
+                const std::string& origin = con->get_origin();
+                return origin == "http://127.0.0.1:8080" || origin == "http://localhost:8080";
+            });
             d_ws_endpt.set_open_handler(std::bind(&op25_audio::ws_open_handler, this, std::placeholders::_1));
             d_ws_endpt.set_close_handler(std::bind(&op25_audio::ws_close_handler, this, std::placeholders::_1));
             d_ws_endpt.set_fail_handler(std::bind(&op25_audio::ws_fail_handler, this, std::placeholders::_1));
